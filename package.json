{
  "name": "codex-relay",
  "productName": "Codex Relay",
  "version": "0.1.0",
  "description": "Windows Codex account and resumable task supervisor",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "electron .",
    "relay": "node scripts/relay.cjs",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "electron": "44.7.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.27.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "dev.superories.codexrelay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/windows",
        "to": "windows"
      },
      {
        "from": "scripts/relay.cjs",
        "to": "relay.cjs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Codex-Relay-Setup-${version}-${arch}.exe"
    },
    "portable": {
      "artifactName": "Codex-Relay-Portable-${version}-${arch}.exe"
    },
    "asar": true
  }
}
